          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/admin/dashboard",
            "headers": [{ "name": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "none" }
          }
        },
        {
          "type": "http",
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/admin/analytics",
            "headers": [{ "name": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "none" }
          }
        },
        {
          "type": "http",
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/admin/orders?page=1&limit=20",
            "headers": [{ "name": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "none" }
          }
        },
        {
          "type": "http",
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000/api/admin/orders/{{orderId}}/status",
            "headers": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"status\": \"SHIPPED\"\n}"
            }
          }
        },
        {
          "type": "http",
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/admin/users?page=1&limit=20",
            "headers": [{ "name": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "none" }
          }
        },
        {
          "type": "http",
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/admin/products",
            "headers": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"title\": \"Test Product\",\n  \"description\": \"A great product for testing\",\n  \"price\": 49.99,\n  \"discountPercentage\": 10,\n  \"stock\": 50,\n  \"brand\": \"LuxeBrand\",\n  \"thumbnail\": \"https://placehold.co/400x400/4f7d52/white?text=Product\",\n  \"images\": [],\n  \"tags\": [\"test\", \"demo\"],\n  \"isFeatured\": true\n}"
            }
          }
        },
        {
          "type": "http",
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000/api/admin/products/{{productId}}",
            "headers": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"price\": 39.99,\n  \"stock\": 100\n}"
            }
          }
        },
        {
          "type": "http",
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000/api/admin/products/{{productId}}",
            "headers": [{ "name": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "none" }
          }
        },
        {
          "type": "http",
          "name": "Create Category",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/admin/categories",
            "headers": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"name\": \"Electronics\",\n  \"slug\": \"electronics\",\n  \"icon\": \"📱\",\n  \"description\": \"All electronics\"\n}"
            }
          }
        }
      ]
    }
  ],
  "environments": [
    {
      "name": "Local",
      "variables": [
        { "name": "baseUrl",    "value": "http://localhost:5000" },
        { "name": "accessToken","value": "paste_token_here_after_login" },
        { "name": "adminToken", "value": "paste_admin_token_here" },
        { "name": "productId",  "value": "paste_product_id_here" },
        { "name": "orderId",    "value": "paste_order_id_here" },
        { "name": "reference",  "value": "paste_payment_ref_here" }
      ]
    }
  ]
}